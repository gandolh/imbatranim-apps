{
  "name": "@imbatranim-apps/root",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server",
    "games",
    "accessories",
    "developer"
  ],
  "scripts": {
    "build:os": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "check:fast": "npm run typecheck && node tools/check-fast.mjs",
    "check:conventions": "knip && depcruise apps accessories developer games packages server tools && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs --warn-only",
    "kit:sync": "node tools/kit-sync.ts",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-virtual": "3.14.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/eslint-plugin": "1.6.28",
    "clsx": "2.1.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "27.4.0",
    "knip": "6.44.2",
    "lucide-react": "1.24.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "pdfjs-dist": "6.4.299",
    "@univerjs/core": {
      "nanoid": "5.1.16"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
